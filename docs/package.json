{
  "name": "devenv-docs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --test scripts/*.test.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:urls": "node validate-urls.mjs",
    "check:links": "cachix-site-check-links dist https://devenv.sh",
    "validate": "npm test && npm run build && npm run validate:urls && npm run check:links",
    "generate:skills-index": "node scripts/generate-skills-index.mjs",
    "generate:technology-icons": "node scripts/generate-technology-icons.mjs",
    "generate:syntax-assets": "node scripts/generate-syntax-assets.mjs",
    "predev": "npm run generate:technology-icons && npm run generate:syntax-assets",
    "prebuild": "npm run generate:skills-index && npm run generate:technology-icons && npm run generate:syntax-assets"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@cachix/site-kit": "https://codeload.github.com/cachix/site-kit/tar.gz/1e9bb1e181430d4a8d632bc8c1487e16de946091",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "hast-util-select": "^6.0.4",
    "marked": "^18.0.7",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "starlight-blog": "^0.28.0",
    "starlight-llm-actions": "^0.13.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "simple-icons": "^16.28.0",
    "typescript": "6.0.3"
  }
}

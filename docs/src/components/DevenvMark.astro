---
import mark from '../assets/devenv-mark.webp';
import markDark from '../assets/devenv-mark-dark.webp';
---

<span class="devenv-mark" aria-hidden="true">
  <img class="devenv-mark-image is-light" src={mark.src} alt="" width="129" height="98" />
  <img class="devenv-mark-image is-dark" src={markDark.src} alt="" width="129" height="98" />
</span>

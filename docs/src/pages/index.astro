---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CodeBlock from '../components/CodeBlock.astro';
import TechnologyIcon from '../components/TechnologyIcon.astro';
import AiCompositionLoader from '../components/AiCompositionLoader.astro';
import { getHighlighter } from '../lib/highlighter';
import { codeThemeNames } from '../lib/code-themes';
import { createLandingEnvironmentCore, documentationComment } from '../lib/landing-environment-core';
import { technologyIconPath } from '../lib/technology-icon-path';
import options from '../data/options.json';
import {
  landingOptionCatalog,
  technologyRegistry,
  validateTechnologyRegistry,
} from '../data/technology-registry';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;

const docs = await getCollection('docs');
const languageTechnologies = technologyRegistry.filter((technology) => technology.kind === 'language');
const serviceTechnologies = technologyRegistry.filter((technology) => technology.kind === 'service');
const utilityTechnologies = technologyRegistry.filter((technology) => technology.kind === 'utility');
const languageCount = languageTechnologies.length;
const serviceCount = serviceTechnologies.length;
const optionCatalog = landingOptionCatalog;
const nixosIcon = technologyIconPath('nixos', '#8BB8FF');
const posts = docs
  .filter((entry) => entry.id.startsWith('blog/') && !entry.data.draft)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const latestPost = posts[0];
const latestPostDate = latestPost?.data.date
  ? new Intl.DateTimeFormat('en', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(latestPost.data.date)
  : null;
const documentedTechnologyIds = docs
  .map((entry) => entry.id)
  .filter((id) => /^(languages|services)\//.test(id) && !/\/(index)$/.test(id));
const registryValidation = validateTechnologyRegistry(documentedTechnologyIds, Object.keys(options));
if (!registryValidation.valid) {
  throw new Error(`Invalid technology registry: ${JSON.stringify(registryValidation)}`);
}

const dup = <T,>(arr: T[]) => [...arr, ...arr];

// Inline nix highlighting for the compose file-tree nodes.
const hl = await getHighlighter();
const nix = (code: string) =>
  hl.codeToHtml(code, { lang: 'nix', themes: codeThemeNames, defaultColor: false, structure: 'inline' });
const initialPrompt = 'Rust API with PostgreSQL, Redis, Docker, tests, and secrets';
const initialEnvironmentCore = createLandingEnvironmentCore(optionCatalog);
const initialPreview = initialEnvironmentCore.buildEnvironment(initialEnvironmentCore.selectPromptMatches(initialPrompt));
const initialEnvironment = initialEnvironmentCore.parseEnvironment(initialPreview);
const escapeHtml = (value: string) => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;');
const initialPreviewHtml = initialEnvironment.lines.map((line, index) => {
  const documentation = documentationComment(line);
  const highlighted = nix(documentation.code || '\u00a0');
  const link = documentation.url && documentation.label
    ? `<a class="landing-code-doc-link" href="${escapeHtml(documentation.url)}" aria-label="Open ${escapeHtml(documentation.label.replace(/^#\s*/, ''))}">${escapeHtml(documentation.label)}</a>`
    : '';
  return `<span class="landing-code-line" data-entry-ids="${escapeHtml(initialEnvironment.lineEntryIds[index].join('|'))}">${highlighted}${link}</span>`;
}).join('');
---

<StarlightPage
  frontmatter={{
    title: 'Your whole development environment, declared.',
    description:
      'Define packages, languages, services, tasks, secrets, and tooling once. Give every developer—and CI—the same fast, reproducible environment.',
    template: 'splash',
    hero: { tagline: '' },
  }}
  hasSidebar={false}
>
<div id="_top"></div>
<div class="not-content">

<!-- ============ HERO ============ -->
<section class="landing-hero" data-environment-hero>
  <div class="landing-cosmos-glow is-blue" aria-hidden="true"></div>
  <div class="landing-cosmos-glow is-violet" aria-hidden="true"></div>
  <div class="landing-hero-inner">
    {latestPost && (
      <a href={`${base}blog/${latestPost.id.replace(/^blog\//, '')}/`} class="csk-latest-post landing-blog-banner">
        <span class="csk-latest-post__aside">
          <span class="csk-latest-post__label">Latest from the blog</span>
          {latestPostDate && <span class="csk-latest-post__date">{latestPostDate}</span>}
        </span>
        <span class="csk-latest-post__title">{latestPost.data.title}</span>
        <span class="csk-latest-post__action" aria-hidden="true">Read post →</span>
      </a>
    )}

    <div class="landing-cosmos-head">
      <h1 class="landing-cosmos-title">
        <span class="is-primary">Your whole development</span><br />{' '}<span>environment, declared.</span>
      </h1>
      <p class="landing-cosmos-subtitle">
        Define packages, languages, services, tasks, secrets, and tooling once. Give every
        developer—and CI—the same fast, reproducible environment.
      </p>
    </div>

    <form class="landing-cosmos-prompt" id="generate">
      <div class="landing-command-bar">
        <span class="landing-command-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 1.4 5.1L18 9l-4.6 1.9L12 16l-1.4-5.1L6 9l4.6-1.9L12 2Z"/><path d="m19 15 .7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7L19 15Z"/></svg>
        </span>
        <input
          type="text"
          name="q"
          id="prompt-input"
          class="landing-command-input"
          placeholder={initialPrompt}
          aria-label="Describe your environment"
        />
        <button type="submit" class="landing-command-submit">Generate with AI <span aria-hidden="true">→</span></button>
      </div>
      <div class="landing-prompt-chips" id="prompt-chips">
        <button type="button" class="landing-chip is-rust" data-chip="Rust API with PostgreSQL">Rust + Postgres</button>
        <button type="button" class="landing-chip is-python" data-chip="Python with uv and PyTorch">Python ML</button>
        <button type="button" class="landing-chip is-node" data-chip="Node.js with Redis">Node + Redis</button>
        <button type="button" class="landing-chip is-go" data-chip="Go microservice with MySQL">Go + MySQL</button>
        <button type="button" class="landing-chip is-ruby" data-chip="Ruby on Rails with React">Rails + React</button>
      </div>
      <span class="landing-compose-feedback" data-compose-feedback role="status" hidden></span>
      <span class="sr-only" data-compose-message aria-live="polite">Ready to compose</span>
    </form>

    <div class="landing-constellation-shell" data-constellation-shell>
      <div class="landing-constellation-main">
        <div class="landing-constellation-map" data-constellation-map>
          <div class="landing-option-pantry" data-option-pantry>
            <div class="landing-option-pantry-copy">
              <strong>Ingredient streams</strong>
              <span>Drag anything into the file. Send configured items back to remove them.</span>
            </div>
            <div class="landing-option-pantry-list" data-option-pantry-list></div>
            <script is:inline type="application/json" id="landing-option-catalog" set:html={JSON.stringify(optionCatalog).replace(/</g, '\\u003c')}></script>
          </div>
          <div class="landing-cosmos-inspector" data-file-dropzone>
            <div class="landing-file-stage" data-file-stage>
              <div class="landing-terminal landing-file-card is-nix" id="preview-terminal">
                <div class="landing-terminal-header">
                  <span class="landing-file-icon" aria-hidden="true"><img src={nixosIcon} alt="" width="24" height="24" /></span>
                  <span class="landing-terminal-title">devenv.nix</span>
                  <button type="button" class="landing-copy-btn" data-copy-target="preview-code">Copy</button>
                </div>
                <pre class="landing-terminal-body"><code
                  id="preview-code"
                  class="language-nix"
                  aria-live="polite"
                  set:html={initialPreviewHtml}
                /></pre>
                <div class="landing-code-minimap" data-code-minimap aria-label="devenv.nix overview"></div>
              </div>
              <div class="landing-terminal landing-file-card is-yaml" id="preview-yaml-terminal" aria-hidden="true" hidden>
                <div class="landing-terminal-header">
                  <span class="landing-file-icon landing-yaml-file-icon" aria-hidden="true">Y</span>
                  <span class="landing-terminal-title">devenv.yaml</span>
                  <button type="button" class="landing-copy-btn" data-copy-target="preview-yaml">Copy</button>
                </div>
                <pre is:raw class="landing-terminal-body" id="preview-yaml-pre"><code id="preview-yaml" class="language-yaml" aria-live="polite"></code></pre>
              </div>
            </div>
            <AiCompositionLoader />
          </div>
        </div>
      </div>
    </div>

    <nav class="landing-cosmos-actions" aria-label="Documentation shortcuts">
      <a href={`${base}getting-started/`} class="landing-btn landing-btn-primary">Build your environment <span aria-hidden="true">→</span></a>
      <a href={`${base}examples/`} class="landing-btn landing-btn-secondary">Explore examples</a>
    </nav>
  </div>
</section>

<!-- ============ MARQUEE ============ -->
<section class="landing-marquee-section">
  <p class="landing-marquee-heading">Languages · Services · Tools</p>

  <div class="landing-marquee">
    <div class="landing-marquee-track">
      {dup(languageTechnologies).map((technology) => (
        <div class="landing-marquee-item">
          <TechnologyIcon technology={technology} size="1.125rem" class="landing-marquee-icon" />
          <span>{technology.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="landing-marquee">
    <div class="landing-marquee-track is-reverse">
      {dup(serviceTechnologies).map((technology) => (
        <div class="landing-marquee-item">
          <TechnologyIcon technology={technology} size="1.125rem" class="landing-marquee-icon" />
          <span>{technology.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="landing-marquee">
    <div class="landing-marquee-track is-slow">
      {dup(utilityTechnologies).map((technology) => (
        <div class="landing-marquee-item">
          <TechnologyIcon technology={technology} size="1.125rem" class="landing-marquee-icon" />
          <span>{technology.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="landing-section">
  <div class="landing-container">
    <div class="landing-section-centered">
      <h2 class="landing-section-title">Three steps. Done.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        From zero to a reproducible environment your whole team can use.
      </p>
    </div>

    <div class="landing-steps">
      <div class="landing-step">
        <span class="landing-step-num">1</span>
        <p class="landing-step-title">Install</p>
        <p class="landing-step-desc">Once Nix is installed. Works on Linux, macOS, and WSL.</p>
        <CodeBlock class="landing-step-code" lang="bash" code="$ nix profile install nixpkgs#devenv" />
      </div>

      <div class="landing-step">
        <span class="landing-step-num">2</span>
        <p class="landing-step-title">Initialize &amp; describe</p>
        <p class="landing-step-desc">Scaffold the project, then edit <code class="inline-code">devenv.nix</code> or generate it from a prompt above.</p>
        <CodeBlock class="landing-step-code" lang="bash" code={`$ devenv init
$EDITOR devenv.nix`} />
      </div>

      <div class="landing-step">
        <span class="landing-step-num">3</span>
        <p class="landing-step-title">Activate</p>
        <p class="landing-step-desc">Everything available, in under 100ms after the first build.</p>
        <CodeBlock class="landing-step-code" lang="bash" code={`$ devenv shell
(devenv) $ cargo run`} />
      </div>
    </div>
  </div>
</section>

<!-- ============ BENTO ============ -->
<section class="landing-section">
  <div class="landing-container">
    <div class="landing-section-centered">
      <h2 class="landing-section-title">Your whole stack, declared together</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Languages, services, processes, tasks, and secrets. Everything is declarative.
      </p>
    </div>

    <div class="landing-bento">
      <a href={`${base}languages/`} class="landing-bento-card is-link landing-bento-2">
        <div class="landing-bento-big-num">{languageCount}</div>
        <p class="landing-bento-title">Languages</p>
        <p class="landing-bento-desc">Python, Rust, Go, Node, Ruby, PHP, Java, Elixir, and more, with version pinning and LSP servers.</p>
      </a>

      <a href={`${base}services/`} class="landing-bento-card is-link landing-bento-2">
        <p class="landing-bento-title">Services</p>
        <p class="landing-bento-desc">{serviceCount} preconfigured services, including PostgreSQL, Redis, MySQL, RabbitMQ, MinIO, Caddy, and Elasticsearch.</p>
        <CodeBlock class="landing-bento-mini-code" lang="nix" code={`services.postgres.enable = true;
services.redis.enable = true;`} />
      </a>

      <a href={`${base}processes/`} class="landing-bento-card is-link landing-bento-2">
        <p class="landing-bento-title">Processes</p>
        <p class="landing-bento-desc">Declarative process management with logs, restarts, and dependencies. Just <code class="inline-code">devenv up</code>.</p>
      </a>

      <a href={`${base}tasks/`} class="landing-bento-card is-link landing-bento-3">
        <p class="landing-bento-title">Tasks &amp; git hooks</p>
        <p class="landing-bento-desc">Define dependencies, run in parallel, hook into your shell or commits. Linters, formatters, codegen.</p>
        <CodeBlock class="landing-bento-mini-code" lang="nix" code={`tasks."app:build" = {
  exec = "yarn build";
  before = [ "devenv:enterShell" ];
};`} />
      </a>

      <a href={`${base}integrations/secretspec/`} class="landing-bento-card is-link landing-bento-3">
        <p class="landing-bento-title">SecretSpec</p>
        <p class="landing-bento-desc">Declarative secrets from Keychain, 1Password, LastPass, or dotenv. Keep values out of config and committed <code class="inline-code">.env</code> files.</p>
        <CodeBlock class="landing-bento-mini-code" lang="nix" code={`processes.api.exec =
  "secretspec run -- npm start";`} />
      </a>

      <a href={`${base}containers/`} class="landing-bento-card is-link landing-bento-2">
        <p class="landing-bento-title">Containers</p>
        <p class="landing-bento-desc">Build OCI containers from your dev environment. Same packages, same versions, same behavior.</p>
      </a>

      <a href={`${base}tests/`} class="landing-bento-card is-link landing-bento-2">
        <p class="landing-bento-title">Tests</p>
        <p class="landing-bento-desc">Run integration tests with all processes active. <code class="inline-code">devenv test</code> and done.</p>
      </a>

      <a href={`${base}basics/`} class="landing-bento-card is-link landing-bento-2">
        <p class="landing-bento-title">Basics</p>
        <p class="landing-bento-desc">Packages, variables, files, and scripts in native <strong>bash</strong>, <strong>zsh</strong>, <strong>fish</strong>, or <strong>nushell</strong>. Auto-activate on <code class="inline-code">cd</code> and apply updates at the next prompt.</p>
      </a>

      <a href={`${base}ad-hoc-developer-environments/`} class="landing-bento-card is-link landing-bento-3">
        <p class="landing-bento-title">Ad-hoc shells, zero config</p>
        <p class="landing-bento-desc">Spin up a temporary environment without writing a <code class="inline-code">devenv.nix</code>. Great for experiments, scripts, and CI matrices.</p>
        <CodeBlock class="landing-bento-mini-code" lang="bash" code={`$ devenv -O languages.python.enable:bool true \\
       -O languages.python.version:string "3.12" \\
       shell`} />
      </a>

      <a href={`${base}packages/`} class="landing-bento-card is-link landing-bento-3">
        <p class="landing-bento-title">Search packages &amp; options</p>
        <p class="landing-bento-desc">Search 100,000+ packages and every devenv option from the CLI, using the exact Nixpkgs version pinned by your project.</p>
        <CodeBlock class="landing-bento-mini-code" lang="bash" code={`$ devenv search postgres
pkgs.postgresql_17
services.postgres.enable`} />
      </a>
    </div>
  </div>
</section>

<!-- ============ Evaluation caching (speed bars) ============ -->
<section class="landing-showcase">
  <div class="landing-container">
    <div class="landing-showcase-head">
      <span class="landing-showcase-eyebrow">Evaluation caching</span>
      <h2 class="landing-section-title">Warm shells in milliseconds.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Auto-invalidated evaluation caching skips unchanged work. No daemons. No manual cache management. <a href={`${base}blog/2024/10/03/devenv-13-instant-developer-environments-with-nix-caching/`} class="landing-link">How it works.</a>
      </p>
    </div>

    <div class="landing-stat-grid">
      <div>
        <p class="landing-stat-caption">Cached shell startup</p>
        <p class="landing-stat-figure">&lt;100<span class="landing-stat-unit">ms</span></p>
      </div>

      <div class="landing-speed-bars" id="speed-bars">
        <div class="landing-bar-row">
          <span class="landing-bar-label">Cold</span>
          <div class="landing-bar-track"><div class="landing-bar-fill is-cold" data-fill="100"></div></div>
          <span class="landing-bar-value">4832 ms</span>
        </div>
        <div class="landing-bar-row">
          <span class="landing-bar-label">Warm</span>
          <div class="landing-bar-track"><div class="landing-bar-fill is-warm" data-fill="0.97"></div></div>
          <span class="landing-bar-value">47 ms</span>
        </div>
        <p class="landing-speedup">Same config. <strong>~100×</strong> faster on every subsequent shell.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ Composability (file tree → merged) ============ -->
<section class="landing-showcase">
  <div class="landing-container">
    <div class="landing-showcase-head">
      <span class="landing-showcase-eyebrow">Composability</span>
      <h2 class="landing-section-title">Many environments. One shell.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Import config across folders and repositories. <a href={`${base}composing-using-imports/`} class="landing-link">First-class monorepo support.</a>
      </p>
    </div>

    <div class="landing-compose">
      <div class="landing-tree">
        <div class="landing-tree-node">
          <div class="landing-tree-node-path">frontend/devenv.nix</div>
          <div class="landing-tree-node-content" set:html={nix('languages.javascript.enable = true;')} />
        </div>
        <div class="landing-tree-node">
          <div class="landing-tree-node-path">backend/devenv.nix</div>
          <div class="landing-tree-node-content" set:html={nix('languages.rust.enable = true;\nservices.postgres.enable = true;')} />
        </div>
        <div class="landing-tree-node">
          <div class="landing-tree-node-path">github:myorg/shared</div>
          <div class="landing-tree-node-content" set:html={nix('services.redis.enable = true;')} />
        </div>
      </div>

      <div class="landing-compose-arrow" aria-hidden="true">→</div>

      <div class="landing-merged">
        <div class="landing-merged-label">Unified environment</div>
        <div class="landing-merged-cmd">$ devenv shell</div>
        <div class="landing-merged-list">
          <span class="landing-merged-chip">node</span>
          <span class="landing-merged-chip">rust</span>
          <span class="landing-merged-chip">postgres</span>
          <span class="landing-merged-chip">redis</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ Profiles ============ -->
<section class="landing-showcase">
  <div class="landing-container">
    <div class="landing-showcase-head">
      <span class="landing-showcase-eyebrow">Profiles</span>
      <h2 class="landing-section-title">One project. Every workflow.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Switch between frontend, backend, testing, and full-stack environments without duplicating configuration. <a href={`${base}profiles/`} class="landing-link">Layer profiles manually or activate them by hostname and user.</a>
      </p>
    </div>

    <div class="landing-profile-grid">
      <div class="landing-profile-stack">
        <div class="landing-profile-card">
          <div class="landing-profile-command">$ devenv --profile backend shell</div>
          <div class="landing-profile-result">
            <span>postgres</span>
            <span>redis</span>
            <span>API tools</span>
          </div>
        </div>

        <div class="landing-profile-card is-highlight">
          <div class="landing-profile-command">$ devenv --profile fullstack up</div>
          <div class="landing-profile-result">
            <span>backend</span>
            <span>frontend</span>
            <span>dev server</span>
          </div>
        </div>

        <div class="landing-profile-card">
          <div class="landing-profile-command">hostname.ci-runner + user.alice</div>
          <div class="landing-profile-result">
            <span>automatic</span>
            <span>deterministic priority</span>
          </div>
        </div>
      </div>

      <div class="landing-terminal">
        <div class="landing-terminal-header">
          <div class="landing-terminal-dots"><span></span><span></span><span></span></div>
          <span class="landing-terminal-title">devenv.nix</span>
        </div>
        <CodeBlock class="landing-terminal-body" lang="nix" code={`profiles = {
  backend.module = {
    services.postgres.enable = true;
    services.redis.enable = true;
  };

  frontend.module = {
    languages.javascript.enable = true;
    processes.dev.exec = "npm run dev";
  };

  fullstack.extends = [ "backend" "frontend" ];
};`} />
      </div>
    </div>
  </div>
</section>

<!-- ============ Native process manager ============ -->
<section class="landing-showcase">
  <div class="landing-container">
    <div class="landing-showcase-head">
      <span class="landing-showcase-eyebrow">Native process manager</span>
      <h2 class="landing-section-title">One <code class="inline-code">devenv up</code>. Whole stack alive.</h2>
      <p class="landing-section-lead landing-section-lead-narrow">
        Built-in process supervision: <a href={`${base}processes/`} class="landing-link">dependencies, ready probes, restart policies, socket activation, automatic port allocation</a>. <a href={`${base}supported-process-managers/`} class="landing-link">Or swap in process-compose, overmind, mprocs.</a>
      </p>
    </div>

    <div class="landing-proc-grid">
      <div class="landing-proc-card">
        <div class="landing-proc-card-head">
          <span class="landing-proc-name">postgres</span>
          <span class="landing-status-pill is-running">running</span>
        </div>
        <div class="landing-proc-meta">port :5432 · uptime 3m 12s</div>
        <div class="landing-proc-feat">ready probe: <code>pg_isready</code></div>
      </div>

      <div class="landing-proc-card">
        <div class="landing-proc-card-head">
          <span class="landing-proc-name">redis</span>
          <span class="landing-status-pill is-running">running</span>
        </div>
        <div class="landing-proc-meta">port :6379 · uptime 3m 12s</div>
        <div class="landing-proc-feat">restart: <code>on-failure</code></div>
      </div>

      <div class="landing-proc-card">
        <div class="landing-proc-card-head">
          <span class="landing-proc-name">migrate</span>
          <span class="landing-status-pill is-ready">completed</span>
        </div>
        <div class="landing-proc-meta">one-shot · exit 0</div>

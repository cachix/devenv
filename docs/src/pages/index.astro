<script>
  // @ts-nocheck
  // ── Live preview generator ──
  (function () {
    var input = document.getElementById('prompt-input');
    var output = document.getElementById('preview-code');
    var form = document.getElementById('generate');
    var chips = document.querySelectorAll('[data-chip]');
    if (!input || !output || !form) return;

    var LANGS = {
      rust:        { test: /\b(rust|cargo|rustc)\b/i,                              key: 'rust',       extra: 'channel = "stable";' },
      python:      { test: /\b(python|django|flask|fastapi|pytorch|torch|uv|pip|ml|machine learning|scikit)\b/i, key: 'python',     extra: 'version = "3.12";\n    venv.enable = true;' },
      javascript:  { test: /\b(node|node\.js|nodejs|javascript|js|react|vue|svelte|next|nest|express)\b/i,       key: 'javascript', extra: 'package = pkgs.nodejs_22;' },
      typescript:  { test: /\btypescript|ts\b/i,                                    key: 'typescript', extra: '' },
      go:          { test: /\b(go|golang)\b/i,                                      key: 'go',         extra: '' },
      ruby:        { test: /\b(ruby|rails)\b/i,                                     key: 'ruby',       extra: 'version = "3.3";' },
      php:         { test: /\bphp|laravel|symfony\b/i,                              key: 'php',        extra: '' },
      java:        { test: /\b(java|kotlin|gradle|maven|spring)\b/i,                key: 'java',       extra: '' },
      elixir:      { test: /\b(elixir|phoenix)\b/i,                                 key: 'elixir',     extra: '' },
      haskell:     { test: /\bhaskell\b/i,                                          key: 'haskell',    extra: '' },
      c:           { test: /\b(c\+\+|cpp|clang|gcc)\b/i,                            key: 'c',          extra: '' },
    };

    var SERVICES = {
      postgres:      { test: /\b(postgres|postgresql|pgsql|pg)\b/i,           key: 'postgres',      extra: 'initialDatabases = [{ name = "app"; }];' },
      mysql:         { test: /\b(mysql|mariadb)\b/i,                          key: 'mysql',         extra: '' },
      redis:         { test: /\bredis|cache\b/i,                              key: 'redis',         extra: '' },
      mongodb:       { test: /\bmongo|mongodb\b/i,                            key: 'mongodb',       extra: '' },
      elasticsearch: { test: /\b(elastic|elasticsearch|opensearch)\b/i,       key: 'elasticsearch', extra: '' },
      rabbitmq:      { test: /\brabbit|rabbitmq|amqp\b/i,                     key: 'rabbitmq',      extra: '' },
      minio:         { test: /\bminio|s3\b/i,                                 key: 'minio',         extra: '' },
      caddy:         { test: /\bcaddy|nginx|reverse proxy\b/i,                key: 'caddy',         extra: '' },
      nats:          { test: /\bnats\b/i,                                     key: 'nats',          extra: '' },
      meilisearch:   { test: /\bmeili|meilisearch|search engine\b/i,          key: 'meilisearch',   extra: '' },
    };

    var PACKAGES = {
      'cargo-watch': /\b(watch|hot reload|live reload)\b/i,
      'docker':      /\bdocker|container\b/i,
      'jq':          /\bjq|json\b/i,
      'ripgrep':     /\bripgrep|rg|grep\b/i,
      'awscli2':     /\baws\b/i,
      'terraform':   /\bterraform|tf\b/i,
    };

    function build(q) {
      var langs = [];
      Object.keys(LANGS).forEach(function (k) {
        if (LANGS[k].test.test(q)) langs.push(LANGS[k]);
      });

      var services = [];
      Object.keys(SERVICES).forEach(function (k) {
        if (SERVICES[k].test.test(q)) services.push(SERVICES[k]);
      });

      var packages = [];
      Object.keys(PACKAGES).forEach(function (k) {
        if (PACKAGES[k].test(q)) packages.push(k);
      });

      // Default state
      if (langs.length === 0 && services.length === 0 && packages.length === 0) {
        return '{ pkgs, ... }: {\n  languages.rust.enable = true;\n\n  services.postgres = {\n    enable = true;\n    initialDatabases = [{ name = "app"; }];\n  };\n\n  packages = [ pkgs.cargo-watch ];\n}';
      }

      var parts = ['{ pkgs, ... }: {'];

      langs.forEach(function (l) {
        if (l.extra) {
          parts.push('  languages.' + l.key + ' = {');
          parts.push('    enable = true;');
          l.extra.split('\n').forEach(function (line) {
            parts.push('    ' + line);
          });
          parts.push('  };');
        } else {
          parts.push('  languages.' + l.key + '.enable = true;');
        }
        parts.push('');
      });

      services.forEach(function (s) {
        if (s.extra) {
          parts.push('  services.' + s.key + ' = {');
          parts.push('    enable = true;');
          parts.push('    ' + s.extra);
          parts.push('  };');
        } else {
          parts.push('  services.' + s.key + '.enable = true;');
        }
        parts.push('');
      });

      if (packages.length > 0) {
        parts.push('  packages = [');
        packages.forEach(function (p) {
          parts.push('    pkgs.' + p);
        });
        parts.push('  ];');
      }

      // trim trailing blank
      while (parts[parts.length - 1] === '') parts.pop();

      parts.push('}');
      return parts.join('\n');
    }

    var hlPromise;
    var themeNames;
    function getHighlighter() {
      if (!hlPromise) {
        hlPromise = Promise.all([
          import('@shikijs/core'),
          import('@shikijs/engine-oniguruma'),
          import('@shikijs/langs/nix'),
          import('@shikijs/langs/yaml'),
          import('../lib/code-themes'),
        ]).then(function (m) {
          var core = m[0], onig = m[1], nix = m[2], yaml = m[3], themes = m[4];
          themeNames = themes.codeThemeNames;
          return core.createHighlighterCore({
            themes: themes.codeThemes,
            langs: [nix.default, yaml.default],
            engine: onig.createOnigurumaEngine(import('shiki/wasm')),
          });
        });
      }
      return hlPromise;
    }

    function setNix(text) {
      output.textContent = text;
      output.classList.add('is-ready');
      getHighlighter()
        .then(function (hl) {
          output.innerHTML = hl.codeToHtml(text, {
            lang: 'nix',
            themes: themeNames,
            defaultColor: false,
            structure: 'inline',
          });
        })
        .catch(function () {
          // The readable plain-text preview is already rendered.
        });
    }

    function update() {
      var q = (input.value || input.placeholder || '').trim();
      setNix(build(q));
    }

    input.addEventListener('input', update);

    // Chips fill input
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        input.value = chip.getAttribute('data-chip') || '';
        input.focus();
        update();
      });
    });

    // Submit → API call, render inline
    var submitBtn = form.querySelector('button[type="submit"]');
    var preview = document.getElementById('preview-terminal');
    var title = document.getElementById('preview-title');
    var yamlPre = document.getElementById('preview-yaml-pre');
    var yamlCode = document.getElementById('preview-yaml');
    var yamlHeader = document.getElementById('preview-yaml-header');
    var yamlDivider = document.getElementById('preview-yaml-divider');

    function showYaml(text) {
      if (text && text.trim() && !/^# See/.test(text.trim())) {
        yamlCode.textContent = text;
        yamlPre.hidden = false;
        yamlHeader.hidden = false;
        yamlDivider.hidden = false;
        getHighlighter()
          .then(function (hl) {
            yamlCode.innerHTML = hl.codeToHtml(text, {
              lang: 'yaml',
              themes: themeNames,
              defaultColor: false,
              structure: 'inline',
            });
          })
          .catch(function () {
            // The readable plain-text preview is already rendered.
          });
      } else {
        yamlPre.hidden = true;
        yamlHeader.hidden = true;
        yamlDivider.hidden = true;
      }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var q = input.value.trim();
      if (!q) {
        input.focus();
        return;
      }

      var originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Generating…';
      title.textContent = 'devenv.nix · generating…';
      setNix('# Talking to devenv.new …\n');

      // Dev: route through Vite proxy to avoid CORS. Prod: hit devenv.new directly (requires CORS headers there).
      var apiBase = location.hostname === 'localhost' || location.hostname === '127.0.0.1'
        ? '/__devenv_api'
        : 'https://devenv.new';

      fetch(apiBase + '/api/generate?q=' + encodeURIComponent(q), {
        method: 'POST',
        mode: 'cors',
      })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) {
          setNix(data.devenv_nix || '');
          showYaml(data.devenv_yaml || '');
          title.textContent = 'devenv.nix · generated';
        })
        .catch(function () {
          // CORS or network — fall back to opening devenv.new in new tab
          title.textContent = 'devenv.nix · opening devenv.new…';
          setNix('# Could not generate inline (CORS).\n# Opening devenv.new in a new tab…\n');
          window.open('https://devenv.new/?q=' + encodeURIComponent(q), '_blank', 'noopener');
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        });
    });

    // The initial preview is highlighted at build time. Subsequent edits use
    // the browser highlighter through the input listener above.
  })();

  // ── Speed bars animate on view ──
  (function () {
    var container = document.getElementById('speed-bars');
    if (!container) return;
    var fills = container.querySelectorAll('.landing-bar-fill');
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        fills.forEach(function (el) {
          var pct = parseFloat(el.getAttribute('data-fill') || '0');
          el.style.width = pct + '%';
        });
        observer.disconnect();
      });
    }, { threshold: 0.3 });
    observer.observe(container);
  })();

  // ── Secret provider switcher ──
  (function () {
    var tabs = document.querySelectorAll('#secret-tabs .landing-provider-tab');
    var name = document.getElementById('secret-provider-name');
    if (!tabs.length || !name) return;
    var labels = {
      keychain:    'macOS Keychain',
      onepassword: '1Password vault',
      lastpass:    'LastPass vault',
      dotenv:      '.env file',
      env:         'Environment variables',
    };
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        var key = tab.getAttribute('data-provider') || 'keychain';
        name.textContent = labels[key] || key;
      });
    });
  })();

  // ── Copy buttons ──
  (function () {
    var buttons = document.querySelectorAll('.landing-copy-btn');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = document.getElementById(btn.getAttribute('data-copy-target') || '');
        if (!target) return;
        var text = target.textContent || '';
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).then(function () {
            btn.textContent = 'Copied';
            btn.classList.add('is-copied');
            setTimeout(function () {
              btn.textContent = 'Copy';
              btn.classList.remove('is-copied');
            }, 1500);
          });
        }
      });
    });
  })();
</script>

